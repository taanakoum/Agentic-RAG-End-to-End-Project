# Template for Render's manually-created rag-production environment group.
# All REPLACE values must be supplied. No frontend needs any of these credentials.
APP_ENV=prod
LOG_JSON=true
LOG_LEVEL=INFO
POSTGRES_HOST=REPLACE_WITH_SESSION_POOLER_HOST_FROM_SUPABASE_CONNECT
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=rag_app.REPLACE_WITH_PROJECT_REF
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_ROLE_PASSWORD
POSTGRES_SCHEMA=rag
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/secrets/supabase-ca.crt
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
CHECKPOINT_POOL_SIZE=2
REDIS_URL=REPLACE_WITH_REDIS_CONNECTION_URL
QDRANT_URL=REPLACE_WITH_HTTPS_QDRANT_CLUSTER_URL
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=REPLACE_WITH_SUPABASE_S3_ENDPOINT
S3_REGION=REPLACE_WITH_PROJECT_REGION
S3_BUCKET=rag-documents
S3_ACCESS_KEY=REPLACE_WITH_STORAGE_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STORAGE_S3_SECRET_KEY
S3_PATH_STYLE=true
MODEL_CACHE_DIR=/data/models
HF_HOME=/data/models/hf
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
# Production refuses weaker password hashing (OWASP minimum).
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
# Same value as the frontend's FRONTEND_CLIENT_IP_SECRET: per-IP limits then see end users,
# not the Streamlit server (32+ random characters).
FRONTEND_CLIENT_IP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
REQUIRE_VERIFIED_EMAIL=true
APP_BASE_URL=https://REPLACE_WITH_FRONTEND.streamlit.app
EMAIL_BACKEND=smtp
EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_STARTTLS=true
CELERY_WORKER_CONCURRENCY=1
MAX_CONCURRENT_HASHES=1
INSPECT_POOL_SIZE=1
PARSE_POOL_SIZE=1
INFERENCE_THREADS=1
PDF_PIPELINE=docling
RERANK_ENABLED=true
# Fill in your chosen provider; tests never use these keys.
LLM_BASE_URL=REPLACE_WITH_OPENAI_COMPATIBLE_HTTPS_ENDPOINT
LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_MODEL=REPLACE_WITH_CURRENT_MODEL_ID
LLM_DAILY_REQUEST_BUDGET=150
LLM_REQUESTS_PER_MINUTE=10
RL_CHAT_DAILY_LIMIT=20
