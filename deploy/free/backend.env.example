# Template for Render's "rag-free" environment group (free-tier variant, docs/FREE_DEPLOYMENT.md).
# Replace every REPLACE value. REDIS_URL comes from the Blueprint (Render Key Value) automatically.
APP_ENV=prod
LOG_JSON=true
LOG_LEVEL=INFO
DEPLOYMENT_PROFILE=free
TASK_RUNNER=inline
WEB_CONCURRENCY=1
# PostgreSQL: Supabase, session pooler (port 5432), private schema, verified TLS
POSTGRES_HOST=REPLACE_WITH_SESSION_POOLER_HOST_FROM_SUPABASE_CONNECT
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=rag_app.REPLACE_WITH_PROJECT_REF
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_ROLE_PASSWORD
POSTGRES_SCHEMA=rag
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/secrets/supabase-ca.crt
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
CHECKPOINT_POOL_SIZE=2
# Vectors: Qdrant Cloud free cluster
QDRANT_URL=REPLACE_WITH_HTTPS_QDRANT_CLUSTER_URL
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION_PREFIX=free_
# Uploads: Supabase Storage through its S3 endpoint (private bucket)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=REPLACE_WITH_SUPABASE_S3_ENDPOINT
S3_REGION=REPLACE_WITH_PROJECT_REGION
S3_BUCKET=rag-documents
S3_ACCESS_KEY=REPLACE_WITH_STORAGE_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STORAGE_S3_SECRET_KEY
S3_PATH_STYLE=true
# Fits 512 MB: hosted dense embeddings, light PDF parsing, no OCR, no re-ranker, small pools
EMBEDDING_BACKEND=hosted
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Free embedding quotas are per minute (see AI Studio); stay under them instead of hitting 429s.
EMBEDDING_API_BATCH_SIZE=20
EMBEDDING_API_INPUTS_PER_MINUTE=60
RERANK_ENABLED=false
# Without the re-ranker, dense alone ranked better than RRF hybrid on real documents (ADR-042).
RETRIEVAL_MODE_WITHOUT_RERANK=dense
PDF_PIPELINE=light
OCR_ENABLED=false
WARM_MODELS_ON_STARTUP=false
INSPECT_POOL_SIZE=1
PARSE_POOL_SIZE=1
MAX_CONCURRENT_HASHES=1
INFERENCE_THREADS=1
# Secrets (generate fresh values; never commit them)
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
FRONTEND_CLIENT_IP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Sign-up: invite-only, because free hosts block SMTP (no verification or reset emails)
REGISTRATION_INVITE_CODE=REPLACE_WITH_AN_INVITE_CODE_OF_12_OR_MORE_CHARACTERS
REQUIRE_VERIFIED_EMAIL=false
EMAIL_BACKEND=file
EMAIL_FILE_DIR=/tmp/outbox
APP_BASE_URL=https://REPLACE_WITH_YOUR_APP.streamlit.app
# Language model and embeddings: one OpenAI-compatible provider (Gemini shown)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_MODEL=REPLACE_WITH_CURRENT_MODEL_ID
LLM_DAILY_REQUEST_BUDGET=150
LLM_REQUESTS_PER_MINUTE=10
RL_CHAT_DAILY_LIMIT=20
