# Paste into Streamlit Community Cloud > your app > Settings > Secrets (root-level keys become
# environment variables for the app). Never put backend credentials here.
FRONTEND_API_URL = "https://REPLACE-WITH-YOUR-SERVICE.onrender.com/api/v1"
FRONTEND_CLIENT_IP_SECRET = "REPLACE_WITH_THE_SAME_VALUE_AS_THE_BACKEND"
FRONTEND_INVITE_REQUIRED = "true"
FRONTEND_WAKE_TIMEOUT_S = "120"
