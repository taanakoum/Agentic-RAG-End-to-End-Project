# Copy to .env and fill in. Never commit .env. No real values belong in this file.
# (Named env.example, not .env.example: the project's permission settings deny access to .env.*)

APP_ENV=dev                    # dev | test | prod (prod enforces JSON logs and a non-default DB password)
LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL (application role; not the superuser)
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=<generate-a-long-random-value>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag_dev

# Redis (Celery broker/result backend, cache, rate limiting)
REDIS_URL=redis://127.0.0.1:6379/0

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=

# Object storage (local volume adapter)
STORAGE_LOCAL_ROOT=./data/objects

# Celery
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT_S=900
CELERY_TASK_SOFT_TIME_LIMIT_S=840

# Native Windows dev setup only (scripts/dev_services.ps1); not read by the app
# POSTGRES_SUPERUSER_PASSWORD=<generate-a-long-random-value>

# Docker Compose only: read by docker-compose.yml (use a value different from your dev password)
# COMPOSE_POSTGRES_PASSWORD=<generate-a-long-random-value>
